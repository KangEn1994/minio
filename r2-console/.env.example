# Copy to .env and set unique local credentials. Never commit .env.
MINIO_ROOT_USER=replace-with-local-access-key
MINIO_ROOT_PASSWORD=replace-with-long-random-secret
# Set this to an HTTPS origin if accessing through a reverse proxy.
CONSOLE_PUBLIC_ORIGIN=http://localhost:9090
# Optional: use a specific MinIO image tag already available to you.
# MINIO_IMAGE=minio/minio:latest
